rules_version = '2';

// Reglas de Firestore del proyecto rol-pintoista.
// Este archivo es la copia versionada: para aplicarlas, se pega el
// contenido entero en la consola de Firebase (Firestore Database →
// Reglas → Publicar). Ver docs/workflow-firebase.md.
//
// Todo cuelga de campanas/{campana}: cada campaña de Rol Pintoísta tiene
// sus propios miembros, tiradas, mapa, etc., sin mezclarse con otras.
// Lo que no está explícitamente permitido acá queda bloqueado.

service cloud.firestore {
  match /databases/{database}/documents {

    function esMiembro(c) {
      return request.auth != null
        && exists(/databases/$(database)/documents/campanas/$(c)/miembros/$(request.auth.uid));
    }
    function esGM(c) {
      return esMiembro(c)
        && get(/databases/$(database)/documents/campanas/$(c)/miembros/$(request.auth.uid)).data.gm == true;
    }

    match /campanas/{c} {
      allow read: if esMiembro(c);
      allow write: if false;

      // El código de campaña vive en privado/acceso ({codigo: "..."}).
      // Nadie lo lee ni lo escribe desde el navegador: se carga a mano en
      // la consola. La regla de miembros lo consulta con get(), que no
      // está sujeto a estas restricciones.
      match /privado/{doc} {
        allow read, write: if false;
      }

      // Un documento por navegador que entró con el código correcto.
      // gm siempre arranca en false; al GM se lo marca a mano en la consola.
      match /miembros/{uid} {
        allow read: if esMiembro(c) || (request.auth != null && request.auth.uid == uid);
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['nombre', 'codigo', 'gm', 'creado'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.nombre.size() <= 40
          && request.resource.data.gm == false
          && request.resource.data.codigo == get(/databases/$(database)/documents/campanas/$(c)/privado/acceso).data.codigo;
        // Cada uno puede cambiar su nombre, pero no darse permisos de GM.
        allow update: if (request.auth != null
            && request.auth.uid == uid
            && request.resource.data.gm == resource.data.gm
            && request.resource.data.codigo == resource.data.codigo)
          || esGM(c);
        allow delete: if esGM(c);
      }

      // Tiradas de dados compartidas (cajita "Mesa" de ficha y gm-tools).
      // Cada uno publica solo a su nombre; nadie las edita; el GM puede borrar.
      match /tiradas/{id} {
        allow read: if esMiembro(c);
        allow create: if esMiembro(c)
          && request.resource.data.keys().hasOnly(['uid', 'jugador', 'quien', 'origen', 'formula', 'rolls', 'mod', 'total', 'desde', 'cuando'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.total is number
          && request.resource.data.rolls is list
          && request.resource.data.rolls.size() <= 100
          && request.resource.data.cuando == request.time;
        allow update: if false;
        allow delete: if esGM(c);
      }

      // Fichas de personaje en vivo (ficha-personaje/ficha.html).
      // Documento principal: {duenoUid, nombre, resumen, miniatura, creado,
      // actualizado}; contenido en partes/{parte}: {json, actualizado}.
      // Son solo de jugadores: todos los miembros las ven; solo el dueño las
      // crea, modifica y borra. El GM no crea ni edita fichas (lo suyo va en
      // gm-tools); solo puede reasignar el dueño.
      match /fichas/{f} {
        allow read: if esMiembro(c);
        allow create: if esMiembro(c)
          && request.resource.data.keys().hasOnly(['duenoUid', 'nombre', 'resumen', 'miniatura', 'creado', 'actualizado'])
          && !esGM(c)
          && request.resource.data.duenoUid == request.auth.uid
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() <= 60
          && request.resource.data.miniatura is string
          && request.resource.data.miniatura.size() < 60000;
        allow update: if esMiembro(c)
          && request.resource.data.keys().hasOnly(['duenoUid', 'nombre', 'resumen', 'miniatura', 'creado', 'actualizado'])
          && request.resource.data.miniatura is string
          && request.resource.data.miniatura.size() < 60000
          && (
            (resource.data.duenoUid == request.auth.uid
              && request.resource.data.duenoUid == resource.data.duenoUid)
            || (esGM(c)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duenoUid']))
          );
        allow delete: if esMiembro(c) && resource.data.duenoUid == request.auth.uid;

        match /partes/{p} {
          allow read: if esMiembro(c);
          allow write: if esMiembro(c)
            && get(/databases/$(database)/documents/campanas/$(c)/fichas/$(f)).data.duenoUid == request.auth.uid
            && !esGM(c);
        }
      }

      // Creeps del GM en vivo (gm-toolset/gm-tools.html). El documento
      // principal es lo que ven todos (nombre, orden, color, resumen de HP y
      // estados, miniatura, firma); privado/ficha y privado/imagen tienen el
      // creep completo y solo los ve el GM. Solo el GM escribe.
      match /creeps/{id} {
        allow read: if esMiembro(c);
        allow write: if esGM(c);
        match /privado/{doc} {
          allow read, write: if esGM(c);
        }
      }

      // Estado general del GM (por ahora, el contador de turno).
      match /gm/{doc} {
        allow read, write: if esGM(c);
      }

      // Imagen de fondo del mapa: {dato, x, y, ancho, actualizado}. La ven
      // todos; solo el GM la pone, la mueve o la quita.
      match /mapa/{doc} {
        allow read: if esMiembro(c);
        allow write: if esGM(c);
      }

      // Tokens del mapa (vtt-hexgrid/mapa.html). tipo 'pj': lo crea, mueve y
      // edita solo su dueño. tipo 'creep': solo el GM. El GM además puede
      // reasignar el dueño de un PJ (solo ese campo) y sacar cualquier token.
      // fichaId (opcional): la ficha (pj) o el creep al que está vinculado.
      function tokenValido(d) {
        return d.keys().hasOnly(['nombre', 'color', 'tipo', 'duenoUid', 'col', 'fila', 'creado', 'fichaId'])
          && (!('fichaId' in d) || (d.fichaId is string && d.fichaId.size() <= 64))
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 40
          && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
          && d.tipo in ['pj', 'creep']
          && d.duenoUid is string
          && d.col is int && d.col >= -2000 && d.col <= 2000
          && d.fila is int && d.fila >= -2000 && d.fila <= 2000;
      }
      match /tokens/{id} {
        allow read: if esMiembro(c);
        allow create: if esMiembro(c)
          && tokenValido(request.resource.data)
          && request.resource.data.duenoUid == request.auth.uid
          && request.resource.data.creado == request.time
          && (request.resource.data.tipo == 'pj' || esGM(c));
        allow update: if esMiembro(c)
          && tokenValido(request.resource.data)
          && request.resource.data.tipo == resource.data.tipo
          && request.resource.data.creado == resource.data.creado
          && (
            (resource.data.tipo == 'pj'
              && resource.data.duenoUid == request.auth.uid
              && request.resource.data.duenoUid == resource.data.duenoUid)
            || (resource.data.tipo == 'creep' && esGM(c))
            || (resource.data.tipo == 'pj' && esGM(c)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['duenoUid']))
          );
        allow delete: if esMiembro(c)
          && (resource.data.duenoUid == request.auth.uid || esGM(c));
      }

      // Paso 0: colección para probar la conexión en vivo.
      match /prueba/{id} {
        allow read: if esMiembro(c);
        allow create: if esMiembro(c) && request.resource.data.uid == request.auth.uid;
        allow delete: if esGM(c);
      }
    }
  }
}
